# Base URL of the Dendrite homeserver (client-facing port), no trailing slash.
DENDRITE_BASE_URL=https://matrix.example.com

# Access token of a Dendrite server admin user. Used to call /_dendrite/admin
# and /_synapse/admin endpoints (all require an admin's bearer token except
# shared-secret registration).
DENDRITE_ADMIN_TOKEN=

# Optional: registration_shared_secret from dendrite.yaml. Only required for
# the register_user tool, which performs shared-secret registration via
# /_synapse/admin/v1/register instead of using the admin token.
DENDRITE_REGISTRATION_SHARED_SECRET=

# --- MCP transport ---
# "stdio" (default): for a client that spawns this process directly (e.g. a
#   local Claude Code / editor MCP config). No network exposure.
# "http": runs a Streamable HTTP MCP server on MCP_HTTP_HOST:MCP_HTTP_PORT,
#   for remote clients over LAN/Tailscale. Requires MCP_AUTH_TOKEN.
MCP_TRANSPORT=stdio

# Required when MCP_TRANSPORT=http. Bearer token clients must send as
# `Authorization: Bearer <token>` to reach /mcp — this is the only thing
# gating a server that can evacuate rooms, purge rooms, and reset passwords.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Only used when MCP_TRANSPORT=http.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3939
