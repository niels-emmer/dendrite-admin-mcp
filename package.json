{
  "name": "dendrite-admin-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Dendrite's admin API (user, room, media, and federation administration) as tools for LLM agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dendrite-admin-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "tsx": "4.23.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
